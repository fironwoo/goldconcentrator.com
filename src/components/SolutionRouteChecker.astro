---
import type { SolutionProfile } from '../data/solutionProfiles';

interface Props {
  profile: SolutionProfile;
  slug: string;
  solutionTitle: string;
  whatsappUrl: string;
}

const { profile, slug, solutionTitle, whatsappUrl } = Astro.props;
const assessmentUrl = `/assess-my-project/?mineral=${profile.formMineral}&source=${encodeURIComponent(slug)}`;
---

<section
  class="route-check"
  id="route-check"
  data-route-check
  data-storage-key={`gc-route-check:${slug}`}
  data-mineral={profile.formMineral}
  data-solution={solutionTitle}
>
  <div class="route-check__intro">
    <span class="eyebrow">Three-question route check</span>
    <h2>Tell me how the material behaves.</h2>
    <p>
      These answers do not produce a final plant design. They help us identify the likely process
      direction, the missing evidence and the first risk worth checking.
    </p>
  </div>

  <div class="route-check__workspace">
    <div class="route-check__progress" aria-label="Route check progress">
      {
        profile.diagnosticQuestions.map((question, index) => (
          <span
            class:list={{ 'is-current': index === 0 }}
            data-route-progress={index}
            aria-current={index === 0 ? 'step' : undefined}
          >
            <b>{index + 1}</b>
            <small>{question.id.replace('-', ' ')}</small>
          </span>
        ))
      }
    </div>

    <form class="route-check__form" data-route-form>
      <div class="route-check__alert" data-route-alert role="alert" hidden></div>
      {
        profile.diagnosticQuestions.map((question, questionIndex) => (
          <fieldset data-route-step={questionIndex} hidden={questionIndex > 0}>
            <legend>
              <span tabindex="-1" data-route-heading>{question.question}</span>
            </legend>
            <p>{question.help}</p>
            <div class="route-options">
              {question.options.map((option) => (
                <label>
                  <input
                    type="radio"
                    name={question.id}
                    value={option.value}
                    data-route-option
                    data-insight={option.insight}
                  />
                  <span>{option.label}</span>
                </label>
              ))}
            </div>
          </fieldset>
        ))
      }
      <div class="route-check__actions">
        <button type="button" class="route-back" data-route-back hidden>Back</button>
        <button type="button" class="button" data-route-next>Continue</button>
      </div>
    </form>

    <aside class="route-result" data-route-result aria-live="polite" tabindex="-1" hidden>
      <span class="eyebrow">Preliminary direction</span>
      <h3>What your answers point to</h3>
      <ul data-route-result-list></ul>
      <div class="route-result__boundary">
        <strong>This is not final equipment selection.</strong>
        <p>Representative data and site conditions still need to confirm the duty and machine size.</p>
      </div>
      <h4>What I would verify next</h4>
      <ul>
        {profile.verificationNeeds.map((item) => <li>{item}</li>)}
      </ul>
      <div class="route-result__actions">
        <a class="button" href={assessmentUrl} data-route-assess>Continue with these notes</a>
        <a
          class="button button--dark"
          href={whatsappUrl}
          data-whatsapp-base={whatsappUrl}
          data-route-whatsapp
        >
          Send ore photos
        </a>
      </div>
      <button type="button" class="route-restart" data-route-restart>Change my answers</button>
    </aside>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-route-check]').forEach((checker) => {
    const form = checker.querySelector<HTMLFormElement>('[data-route-form]');
    if (!form) return;

    const steps = Array.from(form.querySelectorAll<HTMLFieldSetElement>('[data-route-step]'));
    const progress = Array.from(checker.querySelectorAll<HTMLElement>('[data-route-progress]'));
    const back = checker.querySelector<HTMLButtonElement>('[data-route-back]');
    const next = checker.querySelector<HTMLButtonElement>('[data-route-next]');
    const alert = checker.querySelector<HTMLElement>('[data-route-alert]');
    const result = checker.querySelector<HTMLElement>('[data-route-result]');
    const resultList = checker.querySelector<HTMLUListElement>('[data-route-result-list]');
    const assess = checker.querySelector<HTMLAnchorElement>('[data-route-assess]');
    const whatsapp = checker.querySelector<HTMLAnchorElement>('[data-route-whatsapp]');
    const restart = checker.querySelector<HTMLButtonElement>('[data-route-restart]');
    const storageKey = checker.dataset.storageKey || '';
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let currentStep = 0;

    const selectedOptions = () =>
      steps.map((step) => step.querySelector<HTMLInputElement>('input[type="radio"]:checked'));

    const saveAnswers = () => {
      if (!storageKey) return;
      const values = Object.fromEntries(
        selectedOptions().filter(Boolean).map((input) => [input!.name, input!.value]),
      );
      try {
        sessionStorage.setItem(storageKey, JSON.stringify(values));
      } catch {
        // The route checker still works when session storage is unavailable.
      }
    };

    const showStep = (index: number, focus = true) => {
      currentStep = Math.max(0, Math.min(index, steps.length - 1));
      form.hidden = false;
      if (result) result.hidden = true;
      steps.forEach((step, stepIndex) => {
        step.hidden = stepIndex !== currentStep;
      });
      progress.forEach((item, stepIndex) => {
        item.classList.toggle('is-current', stepIndex === currentStep);
        item.classList.toggle('is-complete', stepIndex < currentStep);
        if (stepIndex === currentStep) item.setAttribute('aria-current', 'step');
        else item.removeAttribute('aria-current');
      });
      if (back) back.hidden = currentStep === 0;
      if (next) next.textContent = currentStep === steps.length - 1 ? 'Show my route notes' : 'Continue';
      if (alert) alert.hidden = true;
      if (focus) steps[currentStep]?.querySelector<HTMLElement>('[data-route-heading]')?.focus();
    };

    const showResult = () => {
      const selected = selectedOptions();
      if (selected.some((item) => !item) || !resultList || !result) return;

      resultList.replaceChildren();
      const notes: string[] = [];
      selected.forEach((input) => {
        if (!input) return;
        const insight = input.dataset.insight || '';
        notes.push(insight);
        const item = document.createElement('li');
        item.textContent = insight;
        resultList.append(item);
      });

      const summary = `${checker.dataset.solution} preliminary route check:\n- ${notes.join('\n- ')}`;
      const params = new URLSearchParams({
        mineral: checker.dataset.mineral || 'other',
        source: window.location.pathname,
        routeNotes: summary,
      });
      if (assess) assess.href = `/assess-my-project/?${params.toString()}`;

      if (whatsapp) {
        const whatsappText = [
          `Hello, I am reviewing a ${checker.dataset.solution} project.`,
          ...notes.map((note) => `- ${note}`),
          'I can send ore photos and available test data.',
        ].join('\n');
        whatsapp.href = `${whatsapp.dataset.whatsappBase}?text=${encodeURIComponent(whatsappText)}`;
      }

      saveAnswers();
      form.hidden = true;
      result.hidden = false;
      progress.forEach((item) => {
        item.classList.remove('is-current');
        item.classList.add('is-complete');
        item.removeAttribute('aria-current');
      });
      result.focus({ preventScroll: true });
      result.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'start' });
    };

    try {
      const saved = JSON.parse(sessionStorage.getItem(storageKey) || '{}') as Record<string, string>;
      Object.entries(saved).forEach(([name, value]) => {
        const input = form.querySelector<HTMLInputElement>(
          `input[name="${CSS.escape(name)}"][value="${CSS.escape(value)}"]`,
        );
        if (input) input.checked = true;
      });
      const firstUnanswered = selectedOptions().findIndex((item) => !item);
      if (firstUnanswered >= 0) currentStep = firstUnanswered;
    } catch {
      currentStep = 0;
    }
    showStep(currentStep, false);

    form.addEventListener('change', saveAnswers);

    next?.addEventListener('click', () => {
      const selected = steps[currentStep]?.querySelector<HTMLInputElement>('input[type="radio"]:checked');
      if (!selected) {
        if (alert) {
          alert.textContent = 'Choose the closest answer. It is fine to select "I do not know yet".';
          alert.hidden = false;
        }
        return;
      }
      if (currentStep === steps.length - 1) showResult();
      else showStep(currentStep + 1);
    });

    back?.addEventListener('click', () => showStep(currentStep - 1));
    restart?.addEventListener('click', () => showStep(0));
  });
</script>

<style>
  .route-check {
    display: grid;
    grid-template-columns: minmax(220px, 0.42fr) minmax(0, 1fr);
    gap: clamp(32px, 6vw, 78px);
    padding: clamp(32px, 6vw, 68px);
    border: 1px solid var(--line);
    background: var(--white);
    box-shadow: 0 18px 50px rgba(27, 26, 23, 0.08);
  }

  .route-check__intro {
    align-self: start;
  }

  .route-check__intro h2 {
    margin: 0 0 18px;
    font-family: var(--font-display);
    font-size: clamp(2.3rem, 4vw, 4rem);
    line-height: 0.98;
  }

  .route-check__intro p {
    margin: 0;
    color: var(--muted);
  }

  .route-check__progress {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin-bottom: 34px;
    border-bottom: 1px solid var(--line);
  }

  .route-check__progress span {
    display: flex;
    min-height: 54px;
    align-items: center;
    gap: 9px;
    padding: 0 8px 11px;
    color: #77766f;
    border-bottom: 3px solid transparent;
  }

  .route-check__progress span.is-current {
    color: var(--copper);
    border-color: var(--copper);
  }

  .route-check__progress span.is-complete {
    color: var(--ink);
  }

  .route-check__progress b {
    display: inline-grid;
    width: 28px;
    height: 28px;
    place-items: center;
    border: 1px solid currentColor;
    border-radius: 50%;
    font-size: 0.72rem;
  }

  .route-check__progress small {
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: capitalize;
  }

  .route-check fieldset {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .route-check legend {
    padding: 0;
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 3vw, 2.7rem);
    font-weight: 700;
    line-height: 1.05;
  }

  .route-check fieldset > p {
    margin: 12px 0 22px;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .route-options {
    display: grid;
    gap: 9px;
  }

  .route-options label {
    position: relative;
  }

  .route-options input {
    position: absolute;
    opacity: 0;
  }

  .route-options span {
    display: flex;
    min-height: 52px;
    align-items: center;
    padding: 12px 16px;
    border: 1px solid var(--line);
    background: #fbfaf6;
    cursor: pointer;
    font-weight: 650;
    transition: border-color 160ms ease, background 160ms ease;
  }

  .route-options span::before {
    width: 17px;
    height: 17px;
    margin-right: 12px;
    border: 1px solid #aaa69d;
    border-radius: 50%;
    content: '';
    box-shadow: inset 0 0 0 4px #fbfaf6;
  }

  .route-options input:checked + span {
    border-color: var(--copper);
    background: rgba(138, 76, 32, 0.08);
  }

  .route-options input:checked + span::before {
    border-color: var(--copper);
    background: var(--copper);
  }

  .route-options input:focus-visible + span {
    outline: 3px solid var(--gold-light);
    outline-offset: 3px;
  }

  .route-check__actions,
  .route-result__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 28px;
  }

  .route-back,
  .route-restart {
    min-height: 48px;
    padding: 10px 16px;
    border: 0;
    color: var(--copper);
    background: transparent;
    cursor: pointer;
    font-weight: 750;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .route-check__alert {
    margin-bottom: 18px;
    padding: 12px 14px;
    border-left: 4px solid #a53c2e;
    color: #7a2c22;
    background: #fae8e3;
  }

  .route-result {
    outline: 0;
  }

  .route-result h3 {
    margin: 0 0 18px;
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.5vw, 3.2rem);
    line-height: 1;
  }

  .route-result h4 {
    margin: 26px 0 10px;
    font-size: 1rem;
  }

  .route-result ul {
    margin: 0;
    padding-left: 20px;
  }

  .route-result li + li {
    margin-top: 8px;
  }

  .route-result__boundary {
    margin-top: 22px;
    padding: 16px 18px;
    border-left: 3px solid var(--gold);
    background: var(--paper);
  }

  .route-result__boundary p {
    margin: 4px 0 0;
    color: var(--muted);
    font-size: 0.84rem;
  }

  .button--dark {
    border-color: var(--charcoal);
    color: var(--white);
    background: var(--charcoal);
  }

  .button--dark:hover {
    border-color: var(--copper);
    color: var(--white);
    background: var(--copper);
  }

  @media (max-width: 820px) {
    .route-check {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 520px) {
    .route-check {
      padding: 26px 18px;
    }

    .route-check__progress small {
      display: none;
    }

    .route-check__progress span {
      justify-content: center;
    }

    .route-options span,
    .route-back,
    .route-restart {
      min-height: 48px;
    }

    .route-check__actions .button,
    .route-result__actions .button {
      width: 100%;
    }
  }
</style>
