---
import Logo from './Logo.astro';
import { getWhatsAppUrl, SITE } from '../lib/site';
---

<footer>
  <div class="container footer-lead">
    <div class="footer-statement">
      <Logo light />
      <h2>Start with the ore.<br />Build the flowsheet.<br />Then size the equipment.</h2>
      <p>
        Ore-led flowsheet design, gravity concentration testing and coordinated equipment delivery
        for practical 5-100 TPH mineral processing projects.
      </p>
    </div>
    <aside class="review-desk" aria-label="Project review contact">
      <div class="review-desk__status">
        <span>Project review desk</span>
        <strong>{SITE.responsePromise}</strong>
      </div>
      <p>Send the ore type, target capacity, feed size, country and any photos or test notes you already have.</p>
      <a class="review-desk__email" href={`mailto:${SITE.email}`}>{SITE.email}</a>
      <div class="review-desk__actions">
        <a class="button" href="/assess-my-project/">Assess My Project</a>
        {SITE.whatsapp && <a class="button button--ghost" href={getWhatsAppUrl(SITE.whatsapp)}>WhatsApp</a>}
      </div>
      <small>{SITE.officeAddress}</small>
    </aside>
  </div>
  <div class="container footer-index">
    <span>Browse the process desk</span>
    <nav aria-label="Footer navigation">
      <a href="/solutions/alluvial-gold/">Alluvial Gold</a>
      <a href="/solutions/hard-rock-gold/">Hard Rock Gold</a>
      <a href="/solutions/tin/">Tin</a>
      <a href="/solutions/tungsten/">Tungsten</a>
      <a href="/solutions/chrome/">Chrome</a>
      <a href="/testing-process-design/">Testing & Design</a>
      <a href="/projects/">Projects</a>
      <a href="/knowledge/">Knowledge</a>
      <a href="/manufacturing-delivery/">Delivery</a>
      <a href="/about/">About</a>
    </nav>
  </div>
  <div class="container footer-bottom">
    <span>© {new Date().getFullYear()} Gold Concentrator</span>
    <div>
      <a href="/privacy/">Privacy</a>
      <a href="/terms/">Terms</a>
    </div>
  </div>
</footer>

<style>
  footer {
    padding: 82px 0 28px;
    color: var(--white);
    background: var(--ink);
  }

  .footer-lead {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(320px, 0.7fr);
    align-items: end;
    gap: clamp(48px, 9vw, 120px);
  }

  .footer-statement h2 {
    max-width: 760px;
    margin: 46px 0 24px;
    font-family: var(--font-display);
    font-size: clamp(3rem, 7vw, 6.8rem);
    line-height: 0.87;
    letter-spacing: -0.035em;
    text-transform: uppercase;
  }

  .footer-statement p {
    max-width: 600px;
    margin: 0;
    color: rgba(255, 253, 248, 0.6);
    font-size: 0.92rem;
  }

  .review-desk {
    padding: 30px;
    border-top: 3px solid var(--gold);
    background: var(--charcoal-soft);
  }

  .review-desk__status {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    padding-bottom: 18px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.13);
  }

  .review-desk__status span,
  .footer-index > span {
    color: var(--gold-light);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .review-desk__status strong {
    color: var(--white);
    font-size: 0.68rem;
    text-align: right;
  }

  .review-desk p,
  .review-desk small {
    color: rgba(255, 253, 248, 0.68);
    font-size: 0.82rem;
  }

  .review-desk p {
    margin: 24px 0 18px;
  }

  .review-desk__email {
    display: inline-block;
    color: var(--white);
    font-size: clamp(1rem, 2vw, 1.25rem);
    font-weight: 700;
    overflow-wrap: anywhere;
  }

  .review-desk__email:hover,
  .footer-index a:hover {
    color: var(--gold-light);
  }

  .review-desk__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 24px 0;
  }

  .review-desk .button {
    min-height: 43px;
    padding: 10px 14px;
    font-size: 0.66rem;
  }

  .footer-index {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 30px;
    margin-top: 72px;
    padding: 24px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }

  .footer-index nav {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
  }

  .footer-index a {
    color: rgba(255, 253, 248, 0.68);
    font-size: 0.76rem;
    font-weight: 700;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    margin-top: 22px;
    color: rgba(255, 253, 248, 0.48);
    font-size: 0.75rem;
  }

  .footer-bottom div {
    display: flex;
    gap: 20px;
  }

  .footer-bottom a:hover {
    color: var(--gold-light);
  }

  @media (max-width: 900px) {
    .footer-lead {
      grid-template-columns: 1fr;
    }

    .footer-index {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    footer {
      padding-top: 62px;
    }

    .footer-statement h2 {
      margin-top: 36px;
    }

    .review-desk {
      padding: 24px 20px;
    }

    .review-desk__status,
    .footer-bottom {
      align-items: flex-start;
      flex-direction: column;
    }

    .review-desk__status strong {
      text-align: left;
    }
  }
</style>
