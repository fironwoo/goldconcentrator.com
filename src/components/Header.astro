---
import Logo from './Logo.astro';
import { SITE } from '../lib/site';

const solutions = [
  ['Alluvial Gold', '/solutions/alluvial-gold/'],
  ['Hard Rock Gold', '/solutions/hard-rock-gold/'],
  ['Tin', '/solutions/tin/'],
  ['Tungsten', '/solutions/tungsten/'],
  ['Chrome', '/solutions/chrome/'],
  ['More Minerals', '/solutions/more-minerals/'],
];
const currentPath = Astro.url.pathname;
const isCurrent = (href: string) => currentPath === href;
---

<header class="site-header" data-header>
  <div class="header-utility">
    <div class="container header-utility__inner">
      <span>Mineral processing project enquiries</span>
      <div>
        <span>{SITE.responsePromise}</span>
        <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
      </div>
    </div>
  </div>
  <div class="container header-masthead">
    <Logo light />
    <p class="header-desk-note">
      <strong>Process design before equipment selection</strong>
      <span>Gold, tin, tungsten and chrome / 5–100 TPH</span>
    </p>
    <a class="button header-cta" href="/assess-my-project/" aria-current={isCurrent('/assess-my-project/') ? 'page' : undefined}>Start project review</a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
      <span>Menu</span>
      <i></i>
      <i></i>
    </button>
  </div>
  <div class="header-route-bar">
    <nav class="container" id="site-nav" aria-label="Primary navigation">
      <div class="nav-group">
        <button
          class="nav-trigger"
          type="button"
          aria-expanded="false"
          aria-controls="solutions-dropdown"
        >
          Solutions <span>+</span>
        </button>
        <div class="dropdown" id="solutions-dropdown">
          {
            solutions.map(([label, href]) => (
              <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>{label}</a>
            ))
          }
        </div>
      </div>
      <a href="/testing-process-design/" aria-current={isCurrent('/testing-process-design/') ? 'page' : undefined}>Testing & Process Design</a>
      <a href="/projects/" aria-current={isCurrent('/projects/') ? 'page' : undefined}>Projects</a>
      <a href="/knowledge/" aria-current={isCurrent('/knowledge/') ? 'page' : undefined}>Knowledge</a>
      <a href="/manufacturing-delivery/" aria-current={isCurrent('/manufacturing-delivery/') ? 'page' : undefined}>Manufacturing & Delivery</a>
      <a href="/about/" aria-current={isCurrent('/about/') ? 'page' : undefined}>About</a>
      <a class="button mobile-cta" href="/assess-my-project/" aria-current={isCurrent('/assess-my-project/') ? 'page' : undefined}>Start project review</a>
    </nav>
  </div>
</header>

<script>
  const menu = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = document.querySelector<HTMLElement>('#site-nav');
  const trigger = document.querySelector<HTMLButtonElement>('.nav-trigger');
  const dropdown = document.querySelector<HTMLElement>('.dropdown');
  const header = document.querySelector<HTMLElement>('[data-header]');

  const closeSolutions = (returnFocus = false) => {
    trigger?.setAttribute('aria-expanded', 'false');
    dropdown?.classList.remove('is-open');
    if (returnFocus) trigger?.focus();
  };

  const closeMenu = (returnFocus = false) => {
    menu?.setAttribute('aria-expanded', 'false');
    nav?.classList.remove('is-open');
    closeSolutions();
    if (returnFocus) menu?.focus();
  };

  menu?.addEventListener('click', () => {
    const open = menu.getAttribute('aria-expanded') === 'true';
    menu.setAttribute('aria-expanded', String(!open));
    nav?.classList.toggle('is-open', !open);
    if (open) closeSolutions();
  });

  trigger?.addEventListener('click', () => {
    const open = trigger.getAttribute('aria-expanded') === 'true';
    trigger.setAttribute('aria-expanded', String(!open));
    dropdown?.classList.toggle('is-open', !open);
  });

  nav?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => closeMenu());
  });

  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Node) || header?.contains(event.target)) return;
    closeMenu();
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    if (dropdown?.classList.contains('is-open')) closeSolutions(true);
    else if (nav?.classList.contains('is-open')) closeMenu(true);
  });
</script>

<style>
  .site-header {
    position: absolute;
    z-index: 20;
    top: 0;
    right: 0;
    left: 0;
    color: var(--white);
    background: rgba(20, 21, 20, 0.9);
    backdrop-filter: blur(12px);
  }

  .header-utility {
    border-bottom: 1px solid rgba(255, 255, 255, 0.11);
    color: rgba(255, 253, 248, 0.68);
    background: rgba(8, 9, 8, 0.34);
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .header-utility__inner {
    display: flex;
    min-height: 31px;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .header-utility__inner div {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .header-utility a {
    color: var(--gold-light);
    letter-spacing: 0.04em;
    text-transform: none;
  }

  .header-masthead {
    display: grid;
    min-height: 76px;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 40px;
  }

  .header-desk-note {
    display: grid;
    justify-self: end;
    padding-left: 22px;
    border-left: 1px solid rgba(255, 255, 255, 0.16);
    color: rgba(255, 253, 248, 0.66);
    font-size: 0.7rem;
    line-height: 1.55;
    letter-spacing: 0.07em;
  }

  .header-desk-note strong {
    color: var(--white);
    font-size: 0.68rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .header-route-bar {
    border-top: 1px solid rgba(255, 255, 255, 0.11);
    border-bottom: 1px solid rgba(255, 255, 255, 0.18);
    background: rgba(8, 9, 8, 0.33);
  }

  nav {
    display: flex;
    min-height: 43px;
    align-items: center;
    justify-content: space-between;
    gap: 0;
    color: rgba(255, 253, 248, 0.84);
    font-size: 0.67rem;
    font-weight: 700;
    letter-spacing: 0.055em;
    text-transform: uppercase;
  }

  nav > a:not(.mobile-cta),
  .nav-trigger {
    white-space: nowrap;
    transition: color 160ms ease;
  }

  nav > a:not(.mobile-cta):hover,
  .nav-trigger:hover {
    color: var(--gold-light);
  }

  nav a[aria-current='page'] {
    color: var(--gold-light);
  }

  .nav-group {
    position: relative;
  }

  .nav-trigger {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 13px 0;
    border: 0;
    color: inherit;
    background: transparent;
    cursor: pointer;
    font: inherit;
  }

  .dropdown {
    position: absolute;
    top: 100%;
    left: -20px;
    display: grid;
    width: 230px;
    padding: 12px;
    border-top: 2px solid var(--gold);
    background: var(--charcoal);
    box-shadow: var(--shadow);
    opacity: 0;
    pointer-events: none;
    transform: translateY(8px);
    transition:
      opacity 160ms ease,
      transform 160ms ease;
  }

  .dropdown a {
    padding: 10px 12px;
  }

  .dropdown a:hover {
    color: var(--gold-light);
    background: rgba(255, 255, 255, 0.05);
  }

  .nav-group:hover .dropdown,
  .dropdown.is-open {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  .header-cta,
  .mobile-cta {
    min-height: 40px;
    padding: 9px 14px;
    font-size: 0.66rem;
  }

  .mobile-cta {
    display: none;
  }

  .menu-toggle {
    display: none;
    border: 0;
    color: var(--white);
    background: transparent;
  }

  @media (max-width: 1100px) {
    nav {
      font-size: 0.59rem;
    }

    .header-masthead {
      gap: 24px;
    }

    .header-desk-note {
      font-size: 0.62rem;
    }
  }

  @media (max-width: 900px) {
    .site-header {
      position: absolute;
    }

    .header-utility,
    .header-desk-note,
    .header-cta,
    .header-route-bar {
      display: none;
    }

    .header-masthead {
      display: flex;
      min-height: 78px;
      justify-content: space-between;
    }

    .menu-toggle {
      display: grid;
      width: 48px;
      height: 48px;
      place-content: center;
      gap: 5px;
      cursor: pointer;
    }

    .menu-toggle span {
      position: absolute;
      overflow: hidden;
      width: 1px;
      height: 1px;
      clip: rect(0, 0, 0, 0);
    }

    .menu-toggle i {
      display: block;
      width: 25px;
      height: 2px;
      background: currentColor;
    }

    nav {
      position: absolute;
      top: 78px;
      right: 0;
      left: 0;
      display: none;
      align-items: stretch;
      gap: 0;
      padding: 18px 20px 24px;
      background: var(--charcoal);
      text-transform: none;
    }

    nav.is-open {
      display: grid;
    }

    .header-route-bar:has(nav.is-open) {
      display: block;
    }

    nav > a:not(.mobile-cta),
    .nav-trigger {
      display: flex;
      width: 100%;
      justify-content: space-between;
      padding: 13px 4px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
      font-size: 0.78rem;
    }

    .dropdown {
      position: static;
      display: none;
      width: auto;
      padding: 4px 0 10px 16px;
      border: 0;
      box-shadow: none;
      opacity: 1;
      pointer-events: auto;
      transform: none;
    }

    .dropdown.is-open {
      display: grid;
    }

    .mobile-cta {
      display: flex;
      margin-top: 16px;
    }
  }
</style>
