---
import { getWhatsAppUrl, SITE } from '../lib/site';

const whatsappUrl = `${getWhatsAppUrl(SITE.whatsapp)}?text=${encodeURIComponent(
  'Hello, I would like a manual review of my mineral processing project. I can send ore photos and project notes.',
)}`;
---

<aside class="floating-contact" aria-label="Project contact options" data-floating-contact hidden>
  <button
    class="floating-contact__trigger"
    type="button"
    aria-expanded="false"
    aria-controls="project-contact-panel"
    data-floating-contact-open
  >
    <span>Project review</span>
    <strong>Ask about your ore</strong>
  </button>
  <button
    class="floating-contact__dismiss"
    type="button"
    aria-label="Dismiss project review button"
    data-floating-contact-dismiss
  >
    <span aria-hidden="true">X</span>
  </button>

  <div class="floating-contact__panel" id="project-contact-panel" data-floating-contact-panel hidden>
    <button
      class="floating-contact__close"
      type="button"
      aria-label="Close project contact options"
      data-floating-contact-close
    >
      <span aria-hidden="true">X</span>
    </button>
    <span class="floating-contact__label">Manual review, not live chat</span>
    <strong>Talk to a process reviewer</strong>
    <p>
      Send ore photos, target TPH and country. A person reviews project messages within one
      business day.
    </p>
    <div class="floating-contact__actions">
      <a class="whatsapp" href={whatsappUrl}>WhatsApp</a>
      <a href={`mailto:${SITE.email}`}>Email</a>
    </div>
  </div>
</aside>

<script>
  const floatingContact = document.querySelector<HTMLElement>('[data-floating-contact]');
  const floatingContactOpen = document.querySelector<HTMLButtonElement>('[data-floating-contact-open]');
  const floatingContactPanel = document.querySelector<HTMLElement>('[data-floating-contact-panel]');
  const floatingContactClose = document.querySelector<HTMLButtonElement>('[data-floating-contact-close]');
  const floatingContactDismiss = document.querySelector<HTMLButtonElement>('[data-floating-contact-dismiss]');
  const dismissalKey = 'gc-contact-dismissed';

  const hasDismissedContact = () => {
    try {
      return sessionStorage.getItem(dismissalKey) === 'true';
    } catch {
      return false;
    }
  };

  const showContactTrigger = () => {
    if (!floatingContact || hasDismissedContact()) return;
    if (window.location.pathname.startsWith('/assess-my-project')) return;

    const scrollable = Math.max(document.documentElement.scrollHeight - window.innerHeight, 1);
    const pageProgress = window.scrollY / scrollable;
    if (pageProgress >= 0.18 || window.scrollY >= 520) {
      floatingContact.hidden = false;
      window.removeEventListener('scroll', showContactTrigger);
    }
  };

  floatingContactOpen?.addEventListener('click', () => {
    floatingContactOpen.hidden = true;
    if (floatingContactDismiss) floatingContactDismiss.hidden = true;
    floatingContactOpen.setAttribute('aria-expanded', 'true');
    if (floatingContactPanel) floatingContactPanel.hidden = false;
    floatingContactClose?.focus();
  });

  const dismissContact = () => {
    floatingContact?.setAttribute('hidden', '');
    try {
      sessionStorage.setItem(dismissalKey, 'true');
    } catch {
      // Closing still works when session storage is unavailable.
    }
  };

  floatingContactClose?.addEventListener('click', dismissContact);
  floatingContactDismiss?.addEventListener('click', dismissContact);

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape' || !floatingContactPanel || floatingContactPanel.hidden) return;
    floatingContactPanel.hidden = true;
    if (floatingContactOpen) {
      floatingContactOpen.hidden = false;
      floatingContactOpen.setAttribute('aria-expanded', 'false');
      floatingContactOpen.focus();
    }
    if (floatingContactDismiss) floatingContactDismiss.hidden = false;
  });

  showContactTrigger();
  window.addEventListener('scroll', showContactTrigger, { passive: true });
</script>

<style>
  .floating-contact {
    position: fixed;
    z-index: 60;
    right: 18px;
    bottom: 18px;
    width: min(320px, calc(100vw - 36px));
  }

  .floating-contact__trigger {
    display: grid;
    width: 100%;
    min-height: 56px;
    padding: 10px 52px 10px 16px;
    border: 1px solid rgba(239, 197, 109, 0.45);
    color: var(--white);
    background: var(--charcoal);
    box-shadow: 0 14px 38px rgba(0, 0, 0, 0.2);
    cursor: pointer;
    text-align: left;
  }

  .floating-contact__trigger span {
    color: var(--gold-light);
    font-size: 0.64rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .floating-contact__trigger strong {
    margin-top: 1px;
    font-size: 0.88rem;
  }

  .floating-contact__panel {
    position: relative;
    padding: 20px;
    border: 1px solid rgba(239, 197, 109, 0.34);
    color: var(--white);
    background:
      linear-gradient(135deg, rgba(138, 76, 32, 0.28), rgba(25, 26, 25, 0.97)),
      var(--charcoal);
    box-shadow: 0 20px 70px rgba(0, 0, 0, 0.24);
  }

  .floating-contact__dismiss {
    position: absolute;
    z-index: 1;
    top: 6px;
    right: 6px;
    display: inline-flex;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    border: 1px solid transparent;
    color: rgba(255, 253, 248, 0.72);
    background: transparent;
    cursor: pointer;
    font-size: 0.76rem;
    font-weight: 800;
  }

  .floating-contact__dismiss:hover,
  .floating-contact__dismiss:focus-visible {
    color: var(--ink);
    background: var(--gold-light);
    border-color: var(--gold-light);
  }

  .floating-contact__close {
    position: absolute;
    top: 6px;
    right: 6px;
    display: inline-flex;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    border: 1px solid transparent;
    color: rgba(255, 253, 248, 0.72);
    background: transparent;
    cursor: pointer;
    font-size: 0.76rem;
    font-weight: 800;
  }

  .floating-contact__close:hover {
    color: var(--ink);
    background: var(--gold-light);
    border-color: var(--gold-light);
  }

  .floating-contact__label {
    display: block;
    padding-right: 38px;
    color: var(--gold-light);
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .floating-contact__panel > strong {
    display: block;
    margin-top: 9px;
    font-family: var(--font-display);
    font-size: 1.45rem;
    line-height: 1;
  }

  .floating-contact__panel p {
    margin: 9px 0 15px;
    color: rgba(255, 253, 248, 0.72);
    font-size: 0.82rem;
    line-height: 1.45;
  }

  .floating-contact__actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }

  .floating-contact__actions a {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(255, 253, 248, 0.2);
    color: var(--white);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .floating-contact__actions .whatsapp {
    border-color: var(--gold);
    color: var(--ink);
    background: var(--gold);
  }

  @media (max-width: 720px) {
    .floating-contact {
      right: 10px;
      bottom: calc(10px + env(safe-area-inset-bottom));
      width: min(230px, calc(100vw - 20px));
    }

    .floating-contact__panel {
      padding: 16px;
    }

    .floating-contact__panel p {
      font-size: 0.78rem;
    }
  }
</style>
