---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ProjectCta from '../components/ProjectCta.astro';
import { SITE } from '../lib/site';
---

<BaseLayout
  title="About Gold Concentrator"
  description="A mineral processing team with more than ten years of experience in gravity testing, flowsheet design and equipment coordination."
>
  <header class="page-hero">
    <div class="container">
      <Breadcrumbs items={[{ label: 'About' }]} />
      <span class="eyebrow">Independent process integration</span>
      <h1>About Gold Concentrator</h1>
      <p>
        Gold Concentrator is built around a simple operating principle: understand the ore and
        process requirements before selecting the equipment.
      </p>
    </div>
  </header>
  <section class="section">
    <div class="container content-shell">
      <article class="prose">
        <h2>More than ten years in mineral processing</h2>
        <p>
          Our core team has more than ten years of experience in gravity concentration, flowsheet
          development and equipment coordination. Gold Concentrator is a new brand built on that
          operating experience.
        </p>
        <h2>Focused on gravity concentration</h2>
        <p>
          Gold is the primary market and the reason for the domain. The underlying capability also
          applies to tin, tungsten, chrome and other minerals where density difference, liberation
          and particle size support gravity separation.
        </p>
        <h2>Where gravity works, and where it does not</h2>
        <p>
          We focus on gravity test work and flowsheet development. When an ore requires flotation,
          leaching or specialist mineralogy, we coordinate the work with suitable laboratories.
        </p>
      </article>
      <aside class="sidebar">
        <span class="eyebrow">Contact details</span>
        <h2>Project review contact</h2>
        <p>
          Project enquiries are reviewed through {SITE.email} or WhatsApp. The manufacturing base
          is located at {SITE.officeAddress}.
        </p>
        <a class="button" href="/assess-my-project/">Discuss a project</a>
      </aside>
    </div>
  </section>
  <ProjectCta />
</BaseLayout>
