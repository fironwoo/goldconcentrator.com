---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ProjectCta from '../../components/ProjectCta.astro';
import SolutionRouteChecker from '../../components/SolutionRouteChecker.astro';
import { getSolutionProfile } from '../../data/solutionProfiles';
import { getWhatsAppUrl, SITE } from '../../lib/site';

export async function getStaticPaths() {
  const entries = await getCollection('solutions');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const profile = getSolutionProfile(entry.id);
const projects = await getCollection('projects');
const relatedProjects = profile.relatedProjects
  .map((id) => projects.find((project) => project.id === id))
  .filter((project) => project !== undefined);
const whatsappBase = getWhatsAppUrl(SITE.whatsapp);
const whatsappUrl = `${whatsappBase}?text=${encodeURIComponent(
  `Hello, I am reviewing a ${entry.data.title} project. I can send ore photos and available test data.`,
)}`;
const assessmentUrl = `/assess-my-project/?mineral=${profile.formMineral}&source=${encodeURIComponent(entry.id)}`;
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: entry.data.faq.map((item: { question: string; answer: string }) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
---

<BaseLayout
  title={entry.data.seoTitle}
  description={entry.data.description}
  image={profile.proofImage?.src}
  structuredData={faqSchema}
>
  <header class="page-hero solution-hero">
    <div class="container">
      <Breadcrumbs items={[{ label: 'Solutions', href: '/#solutions' }, { label: entry.data.title }]} />
      <div class="solution-hero__grid">
        <div class="solution-hero__copy">
          <span class="eyebrow">{entry.data.eyebrow}</span>
          <h1>{entry.data.title}</h1>
          <p class="solution-hero__prompt">{profile.heroPrompt}</p>
          <p>{entry.data.description}</p>
          <div class="solution-hero__actions">
            <a class="button" href="#route-check">Check my likely route</a>
            <a class="button button--ghost" href={whatsappUrl}>Send ore photos</a>
          </div>
        </div>
        {
          profile.proofImage && (
            <figure class="solution-proof">
              <img
                src={profile.proofImage.src}
                alt={profile.proofImage.alt}
                width="980"
                height="680"
                loading="eager"
                decoding="async"
                fetchpriority="high"
              />
              <figcaption>{profile.proofImage.caption}</figcaption>
            </figure>
          )
        }
      </div>
    </div>
  </header>

  <section class="reviewer-strip" aria-label="Manual process review">
    <div class="container reviewer-strip__inner">
      <span>Manual process review</span>
      <p>{profile.reviewerIntro}</p>
      <strong>First reply within one business day</strong>
    </div>
  </section>

  <section class="section ore-fit">
    <div class="container">
      <div class="ore-fit__heading">
        <span class="eyebrow">Before a machine model</span>
        <h2>Check whether this route fits the ore.</h2>
        <p>
          The mineral name is only the starting point. These conditions decide whether this page is
          relevant or whether another test route is needed.
        </p>
      </div>
      <div class="ore-fit__grid">
        <article>
          <span class="fit-label">A useful starting point for</span>
          <ul>{profile.suitableFor.map((item) => <li>{item}</li>)}</ul>
        </article>
        <article>
          <span class="fit-label">The route may change when</span>
          <ul>{profile.routeMayChangeWhen.map((item) => <li>{item}</li>)}</ul>
        </article>
      </div>
    </div>
  </section>

  <section class="section route-check-section">
    <div class="container">
      <SolutionRouteChecker
        profile={profile}
        slug={entry.id}
        solutionTitle={entry.data.title}
        whatsappUrl={whatsappBase}
      />
    </div>
  </section>

  <section class="section solution-detail" id="process-logic">
    <div class="container content-shell">
      <article class="prose solution-prose">
        <Content />

        <section class="process-section" aria-labelledby="process-heading">
          <span class="section-kicker">Indicative route, not a fixed package</span>
          <h2 id="process-heading">Typical process logic</h2>
          <p class="section-lead">
            Open each stage to see the duty it performs. Test data can remove, add or change a
            stage before equipment is sized.
          </p>
          <div class="process-list">
            {
              entry.data.processSteps.map(
                (step: { title: string; description: string }, index: number) => (
                  <details open={index === 0}>
                    <summary>
                      <span>{String(index + 1).padStart(2, '0')}</span>
                      <h3>{step.title}</h3>
                    </summary>
                    <p>{step.description}</p>
                  </details>
                ),
              )
            }
          </div>
        </section>

        <section class="equipment-section" aria-labelledby="equipment-heading">
          <span class="section-kicker">Duty before model number</span>
          <h2 id="equipment-heading">Why equipment appears in the route</h2>
          <p class="section-lead">
            These are process duties, not a shopping list. Feed conditions and mass flow decide
            whether a machine belongs in the final scope.
          </p>
          <div class="role-grid">
            {
              entry.data.equipmentRoles.map((role: { title: string; description: string }) => (
                <article>
                  <span>Process role</span>
                  <h3>{role.title}</h3>
                  <p>{role.description}</p>
                </article>
              ))
            }
          </div>
        </section>

        {
          relatedProjects.length > 0 && (
            <section class="evidence-section" aria-labelledby="evidence-heading">
              <span class="section-kicker">Comparable operating conditions</span>
              <h2 id="evidence-heading">Case notes to compare with your ore</h2>
              <p class="section-lead">
                A reference case shows how a previous scope was reasoned. It is not a design
                recommendation for a different deposit.
              </p>
              <div class="evidence-list">
                {relatedProjects.map((project) => (
                  <article>
                    <div>
                      <span>{project.data.country}</span>
                      <span>{project.data.capacity}</span>
                    </div>
                    <h3>
                      <a href={`/projects/${project.id}/`}>{project.data.title}</a>
                    </h3>
                    <p>{project.data.description}</p>
                    <a class="text-link" href={`/projects/${project.id}/`}>Compare project conditions</a>
                  </article>
                ))}
              </div>
            </section>
          )
        }

        <section class="faq-section" aria-labelledby="faq-heading">
          <span class="section-kicker">Questions that change the scope</span>
          <h2 id="faq-heading">Frequently asked questions</h2>
          <div class="faq">
            {
              entry.data.faq.map((item: { question: string; answer: string }) => (
                <details>
                  <summary>{item.question}</summary>
                  <p>{item.answer}</p>
                </details>
              ))
            }
          </div>
        </section>
      </article>

      <aside class="sidebar solution-sidebar">
        <span class="eyebrow">Your first reply</span>
        <h2>What a reviewer will return</h2>
        <ol>
          <li><b>01</b><span>The likely process direction from the facts supplied</span></li>
          <li><b>02</b><span>The missing data that could change the route</span></li>
          <li><b>03</b><span>Whether testing, sizing or a detailed scope should come next</span></li>
        </ol>
        <p>We will not generate a final equipment package from capacity alone.</p>
        <a class="button" href={assessmentUrl}>Continue project review</a>
      </aside>
    </div>
  </section>

  <ProjectCta title={`Send the ore facts before we size the ${entry.data.title.toLowerCase()} route.`} />
</BaseLayout>

<style>
  .solution-hero {
    padding: 128px 0 58px;
  }

  .solution-hero::after {
    display: none;
  }

  .solution-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(340px, 0.72fr);
    align-items: end;
    gap: clamp(40px, 7vw, 92px);
  }

  .solution-hero h1 {
    max-width: 800px;
    font-size: clamp(3.2rem, 7vw, 6.4rem);
    text-transform: none;
  }

  .solution-hero__prompt {
    max-width: 700px;
    margin-top: 22px;
    color: var(--white);
    font-size: clamp(1.05rem, 1.6vw, 1.3rem);
    font-weight: 700;
  }

  .solution-hero__copy > p:not(.solution-hero__prompt) {
    margin-top: 12px;
  }

  .solution-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 28px;
  }

  .solution-proof {
    margin: 0;
    border: 1px solid rgba(255, 255, 255, 0.18);
    background: #141514;
    box-shadow: 0 22px 60px rgba(0, 0, 0, 0.28);
  }

  .solution-proof img {
    width: 100%;
    height: auto;
    aspect-ratio: 49 / 34;
    object-fit: cover;
  }

  .solution-proof figcaption {
    padding: 12px 14px;
    color: rgba(255, 253, 248, 0.66);
    font-size: 0.72rem;
    line-height: 1.45;
  }

  .reviewer-strip {
    color: var(--white);
    background: var(--copper);
  }

  .reviewer-strip__inner {
    display: grid;
    grid-template-columns: 180px minmax(0, 1fr) 240px;
    align-items: center;
    gap: 24px;
    min-height: 72px;
  }

  .reviewer-strip span,
  .reviewer-strip strong {
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .reviewer-strip p {
    margin: 0;
    color: rgba(255, 255, 255, 0.82);
    font-size: 0.86rem;
  }

  .reviewer-strip strong {
    text-align: right;
  }

  .ore-fit {
    padding-bottom: 64px;
  }

  .ore-fit__heading {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(280px, 0.42fr);
    gap: 12px 48px;
    margin-bottom: 32px;
  }

  .ore-fit__heading .eyebrow {
    grid-column: 1 / -1;
    margin: 0;
  }

  .ore-fit__heading h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5vw, 4.7rem);
    line-height: 0.98;
  }

  .ore-fit__heading p {
    align-self: end;
    margin: 0;
    color: var(--muted);
  }

  .ore-fit__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .ore-fit article {
    padding: clamp(24px, 4vw, 38px);
    border: 1px solid var(--line);
    background: rgba(255, 253, 248, 0.72);
  }

  .ore-fit article:last-child {
    border-top: 3px solid var(--copper);
  }

  .ore-fit article:first-child {
    border-top: 3px solid var(--gold);
  }

  .fit-label,
  .section-kicker {
    color: var(--copper);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .ore-fit ul {
    margin: 18px 0 0;
    padding: 0;
    list-style: none;
  }

  .ore-fit li {
    position: relative;
    padding: 12px 0 12px 24px;
    border-top: 1px solid var(--line);
  }

  .ore-fit li::before {
    position: absolute;
    top: 21px;
    left: 2px;
    width: 8px;
    height: 8px;
    border: 2px solid var(--gold);
    border-radius: 50%;
    content: '';
  }

  .route-check-section {
    padding: 0 0 96px;
  }

  .solution-detail {
    background: var(--paper-deep);
  }

  .solution-prose > :global(h2:first-child) {
    margin-top: 0;
  }

  .process-section,
  .equipment-section,
  .evidence-section,
  .faq-section {
    margin-top: 78px;
  }

  .section-lead {
    margin: -6px 0 24px;
    color: var(--muted);
  }

  .process-list {
    margin-top: 22px;
    border-bottom: 1px solid var(--line);
  }

  .process-list details {
    border-top: 1px solid var(--line);
    background: rgba(255, 253, 248, 0.42);
  }

  .process-list summary {
    display: grid;
    grid-template-columns: 54px 1fr;
    align-items: center;
    gap: 16px;
    min-height: 76px;
    padding: 14px 18px;
    cursor: pointer;
    list-style: none;
  }

  .process-list summary::-webkit-details-marker {
    display: none;
  }

  .process-list summary > span {
    color: var(--copper);
    font-family: var(--font-display);
    font-size: 1.4rem;
  }

  .process-list summary h3 {
    margin: 0;
    font-size: 1.45rem;
    text-transform: none;
  }

  .process-list summary h3::after {
    float: right;
    content: '+';
    font-family: var(--font-body);
    font-weight: 400;
  }

  .process-list details[open] summary h3::after {
    content: '-';
  }

  .process-list details > p {
    margin: 0;
    padding: 0 24px 22px 88px;
  }

  .role-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  .role-grid article {
    padding: 24px;
    border: 1px solid var(--line);
    background: rgba(255, 253, 248, 0.72);
  }

  .role-grid article > span {
    color: var(--copper);
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .role-grid h3 {
    margin: 8px 0;
    font-size: 1.45rem;
    text-transform: none;
  }

  .role-grid p {
    margin: 0;
    font-size: 0.88rem;
  }

  .evidence-list {
    display: grid;
    gap: 12px;
  }

  .evidence-list article {
    padding: 24px;
    border-left: 4px solid var(--gold);
    background: var(--white);
  }

  .evidence-list article > div {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .evidence-list article > div span {
    padding: 3px 7px;
    border: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.66rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .evidence-list h3 {
    margin: 14px 0 8px;
    font-size: 1.55rem;
    text-transform: none;
  }

  .evidence-list h3 a:hover {
    color: var(--copper);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .evidence-list p {
    margin: 0 0 12px;
  }

  .faq details {
    border-top: 1px solid var(--line);
  }

  .faq details:last-child {
    border-bottom: 1px solid var(--line);
  }

  .faq summary {
    min-height: 58px;
    padding: 17px 0;
    cursor: pointer;
    font-weight: 700;
  }

  .faq p {
    margin: 0 0 20px;
  }

  .solution-sidebar ol {
    margin: 18px 0;
    padding: 0;
    list-style: none;
  }

  .solution-sidebar li {
    display: grid;
    grid-template-columns: 30px 1fr;
    gap: 10px;
    padding: 12px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }

  .solution-sidebar li b {
    color: var(--gold-light);
    font-family: var(--font-display);
  }

  .solution-sidebar li span {
    color: rgba(255, 253, 248, 0.74);
    font-size: 0.78rem;
    line-height: 1.45;
  }

  .solution-sidebar .button {
    width: 100%;
    margin-top: 8px;
  }

  @media (max-width: 900px) {
    .solution-hero__grid,
    .ore-fit__heading,
    .ore-fit__grid {
      grid-template-columns: 1fr;
    }

    .solution-proof {
      max-width: 620px;
    }

    .reviewer-strip__inner {
      grid-template-columns: 1fr;
      gap: 5px;
      padding-top: 16px;
      padding-bottom: 16px;
    }

    .reviewer-strip strong {
      text-align: left;
    }
  }

  @media (max-width: 640px) {
    .solution-hero {
      padding-top: 112px;
    }

    .solution-hero__actions .button {
      width: 100%;
    }

    .role-grid {
      grid-template-columns: 1fr;
    }

    .process-list summary {
      grid-template-columns: 42px 1fr;
      padding: 12px;
    }

    .process-list details > p {
      padding: 0 14px 18px 66px;
    }
  }
</style>
