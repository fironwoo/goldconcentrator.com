---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ProjectCta from '../../components/ProjectCta.astro';

const articles = (await getCollection('knowledge')).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);
const publishedVideoCount = (await getCollection('videos')).filter(
  (entry) => !entry.data.draft && (entry.data.videoFile || entry.data.youtubeUrl),
).length;
---

<BaseLayout
  title="Mineral Processing Knowledge & Field Notes"
  description="Practical guidance on gold processing, gravity concentration, flowsheet decisions, plant sizing and avoidable equipment selection errors."
>
  <header class="page-hero">
    <div class="container">
      <Breadcrumbs items={[{ label: 'Knowledge' }]} />
      <span class="eyebrow">Process decisions explained</span>
      <h1>Knowledge</h1>
      <p>
        Clear guidance for mine owners, backed by enough process detail for engineers to examine
        the assumptions.
      </p>
    </div>
  </header>
  <section class="section">
    <div class="container article-grid">
      {articles.map((article) => (
        <article class:list={['surface-card', { 'surface-card--media': article.data.coverImage }] }>
          {
            article.data.coverImage && (
              <img
                class="card-cover"
                src={article.data.coverImage.src}
                alt={article.data.coverImage.alt}
                width="980"
                height="680"
                loading="lazy"
                decoding="async"
              />
            )
          }
          <span class="tag">{article.data.category}</span>
          <time datetime={article.data.publishedAt.toISOString()}>
            {article.data.publishedAt.toLocaleDateString('en', { dateStyle: 'medium' })}
          </time>
          <h2>{article.data.title}</h2>
          <p>{article.data.description}</p>
          <a class="text-link" href={`/knowledge/${article.id}/`}>Read article</a>
        </article>
      ))}
    </div>
    {
      publishedVideoCount > 0 && (
        <div class="container video-entry">
          <p>Prefer workshop footage to a long article?</p>
          <a class="text-link" href="/videos/">View field and equipment videos</a>
        </div>
      )
    }
  </section>
  <ProjectCta />
</BaseLayout>

<style>
  .article-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
  }

  article {
    min-height: 340px;
  }

  .surface-card--media {
    padding-top: 0;
  }

  .card-cover {
    width: calc(100% + 56px);
    aspect-ratio: 16 / 9;
    margin: 0 -28px 24px;
    object-fit: cover;
    background: var(--charcoal);
  }

  .video-entry {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-top: 28px;
    padding: 22px 26px;
    border: 1px solid var(--line);
    background: rgba(255, 253, 248, 0.72);
  }

  .video-entry p {
    margin: 0;
    color: var(--muted);
  }

  time {
    display: block;
    margin-top: 18px;
    color: var(--muted);
    font-size: 0.72rem;
  }

  h2 {
    margin: 28px 0 14px;
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3.2rem);
    line-height: 0.98;
    text-transform: uppercase;
  }

  @media (max-width: 700px) {
    .article-grid {
      grid-template-columns: 1fr;
    }

    .video-entry {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
