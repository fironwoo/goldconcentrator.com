---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import homepageData from '../data/homepage.json';
import { getHomepageSolutionCards, getWhatsAppUrl, SITE } from '../lib/site';

const primarySolutionMedia = {
  'alluvial-gold': homepageData.primarySolutionMedia.alluvialGold,
  'hard-rock-gold': homepageData.primarySolutionMedia.hardRockGold,
};
const solutionCards = getHomepageSolutionCards().map((solution) => ({
  ...solution,
  media: primarySolutionMedia[solution.slug as keyof typeof primarySolutionMedia],
}));
const heroVideoActive = homepageData.hero.enableVideo && Boolean(homepageData.hero.video);
const projects = (await getCollection('projects'))
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured))
  .slice(0, 3);
const articles = (await getCollection('knowledge'))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0, 3);
const videos = (await getCollection('videos'))
  .filter((entry) => !entry.data.draft && (entry.data.youtubeUrl || entry.data.videoFile))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const featuredVideo = videos.find((entry) => entry.data.featured) ?? videos[0];
---

<BaseLayout
  title="Gold Processing & Gravity Solutions"
  description="Ore-led flowsheet design and gravity concentration equipment for 5-100 TPH gold, tin, tungsten and chrome projects."
  image={homepageData.hero.poster}
  imageWidth={1915}
  imageHeight={821}
>
  <section class="hero">
    <div class="hero-media">
      {
        heroVideoActive ? (
          <video
            data-hero-video
            muted
            loop
            playsinline
            preload="metadata"
            poster={homepageData.hero.poster}
            aria-describedby="hero-media-caption"
          >
            <source src={homepageData.hero.video} type="video/mp4" />
          </video>
        ) : (
          <img
            src={homepageData.hero.poster}
            alt="Large rotary mineral processing equipment inside the Jiangxi workshop"
            width="1915"
            height="821"
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
        )
      }
    </div>
    <div class="hero-media-tools">
      <p id="hero-media-caption">
        <strong>Workshop evidence</strong>
        <span>{homepageData.hero.caption}</span>
      </p>
      {
        heroVideoActive && (
          <button class="hero-video-toggle" type="button" data-hero-video-toggle aria-pressed="false">
            Pause video
          </button>
        )
      }
    </div>
    <div class="container hero-content">
      <span class="eyebrow">Gold processing and gravity concentration</span>
      <h1>The Right Equipment Starts With the Right Flowsheet.</h1>
      <p>
        We assess the ore, test the recovery route and coordinate the equipment around the
        flowsheet for practical 5–100 TPH mineral processing projects.
      </p>
      <div class="hero-actions">
        <a class="button" href="/assess-my-project/">Assess My Gold Project</a>
        <a class="button button--ghost" href="#solutions">Explore Solutions</a>
      </div>
      <div class="hero-human">
        <strong>A real person reviews every project message.</strong>
        <span>
          WhatsApp is fastest for photos and short videos. Tell me what you already have on site:
          ore type, target TPH, feed size, country, water, power and existing equipment.
        </span>
        <em>I will not guess the flowsheet from a machine list. The ore facts come first.</em>
        <a href={getWhatsAppUrl(SITE.whatsapp)}>Message us on WhatsApp</a>
      </div>
      <ul class="hero-proof" aria-label="Key capabilities">
        <li><strong>10+ years</strong><span>Core team experience</span></li>
        <li><strong>Ore-led</strong><span>Process before equipment</span></li>
        <li><strong>5–100 TPH</strong><span>Target project range</span></li>
      </ul>
    </div>
  </section>

  <section class="principle">
    <div class="container principle-grid">
      <h2>What I check before naming equipment.</h2>
      <ul class="principle-checks">
        <li>
          <strong>Clay and washing difficulty</strong>
          <small>Free washing sand and sticky clay need very different front-end treatment.</small>
        </li>
        <li>
          <strong>Feed size before and after screening</strong>
          <small>The cut size decides what reaches the concentrator, jig, table or mill.</small>
        </li>
        <li>
          <strong>Where the valuable mineral may be lost</strong>
          <small>Fine gold, cassiterite or chromite losses often start before the main machine.</small>
        </li>
      </ul>
    </div>
  </section>

  <section class="section response-path">
    <div class="container">
      <div class="section-heading">
        <div>
          <h2>What happens after you send a message.</h2>
        </div>
        <p>
          You are not dropped into an equipment catalog. A process reviewer checks the ore facts
          first, then asks for the missing details before suggesting a practical route.
        </p>
      </div>
      <div class="response-desk">
        <article class="response-desk__lead">
          <span>Before I name any machine</span>
          <h3>Send the rough facts, even when the project is incomplete.</h3>
          <p>
            A phone video of the ore and a short message are enough to begin. I will tell you which
            missing facts can change the flowsheet and which details can wait.
          </p>
          <a class="text-link" href="/assess-my-project/">Prepare a project brief</a>
        </article>
        <ol class="response-sequence">
          <li>
            <span>01</span>
            <div>
              <h3>You send what is known</h3>
              <p>Ore type, country, target TPH, feed size, photos, videos and any test or assay notes.</p>
            </div>
          </li>
          <li>
            <span>02</span>
            <div>
              <h3>I check the missing process facts</h3>
              <p>Clay, water, power, existing equipment, project stage and where valuable mineral may be lost.</p>
            </div>
          </li>
          <li>
            <span>03</span>
            <div>
              <h3>We discuss a practical route</h3>
              <p>Usually within one business day: likely flowsheet, missing data, test needs and equipment duties.</p>
            </div>
          </li>
        </ol>
      </div>
    </div>
  </section>

  <section class="section" id="solutions">
    <div class="container">
      <div class="section-heading">
        <div>
          <h2>Start with your ore type.</h2>
        </div>
        <p>
          Gold is our primary focus. Tin, tungsten, chrome and other dense minerals are assessed
          through the same gravity concentration discipline.
        </p>
      </div>
      <div class="solution-grid">
        {solutionCards.map((solution, index) => (
          <a
            class:list={[
              'solution-card',
              `solution-card--${solution.category}`,
              { 'solution-card--primary': index < 2 },
            ]}
            href={`/solutions/${solution.slug}/`}
          >
            {
              solution.media && (
                <figure class="solution-card__media">
                  <img
                    src={solution.media.src}
                    alt={solution.media.alt}
                    width="1672"
                    height="941"
                    loading="lazy"
                    decoding="async"
                  />
                  <figcaption>{solution.media.caption}</figcaption>
                </figure>
              )
            }
            <span class="solution-card__number">{String(index + 1).padStart(2, '0')}</span>
            <div class="solution-card__body">
              <small>{solution.category === 'gold' ? 'Primary gold route' : solution.category === 'more' ? 'Additional capability' : 'Gravity mineral'}</small>
              <h3>{solution.name}</h3>
              <p>{solution.summary}</p>
              <strong>View solution →</strong>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--dark">
    <div class="container">
      <div class="section-heading">
        <div>
          <h2>From project data to shipment.</h2>
        </div>
        <p>
          The level of detail grows with the project. Initial direction is free; detailed design,
          calculations and drawings are scoped separately and may be credited against an equipment
          order.
        </p>
      </div>
      <ol class="process">
        <li><span>01</span><h3>Assess</h3><p>Review the ore, capacity, location and project stage.</p></li>
        <li><span>02</span><h3>Test</h3><p>Use representative samples to check gravity response and losses.</p></li>
        <li><span>03</span><h3>Design</h3><p>Define the flowsheet, operating logic and equipment roles.</p></li>
        <li><span>04</span><h3>Coordinate</h3><p>Manage manufacturing, quality checks and project interfaces.</p></li>
        <li><span>05</span><h3>Deliver</h3><p>Prepare packing, documentation and export shipment.</p></li>
      </ol>
    </div>
  </section>

  <section class="section workshop-evidence">
    <div class="container">
      <div class="section-heading">
        <div>
          <h2>Workshop, packing and delivery checks.</h2>
        </div>
        <p>
          A few real workshop views are enough for the first version. When your own approved project
          photos are ready, these can be replaced one by one without changing the page structure.
        </p>
      </div>
      <div class="workshop-grid" aria-label="Factory and delivery reference images">
        <figure>
          <img
            src="/images/factory/gold-trommel-workshop.webp"
            alt="Gold trommel screen in workshop before delivery"
            width="980"
            height="680"
            loading="lazy"
            decoding="async"
          />
          <figcaption>
            <strong>Washing section</strong>
            <span>Check feed size, clay level, water volume and screen opening before selecting recovery equipment.</span>
          </figcaption>
        </figure>
        <figure>
          <img
            src="/images/factory/shaking-table-workshop.webp"
            alt="Shaking table workshop reference"
            width="980"
            height="680"
            loading="lazy"
            decoding="async"
          />
          <figcaption>
            <strong>Finishing section</strong>
            <span>Tables, chutes and concentrators must match the actual size range after screening or grinding.</span>
          </figcaption>
        </figure>
        <figure>
          <img
            src="/images/factory/screen-loading-delivery.webp"
            alt="Screen equipment loading and delivery preparation"
            width="980"
            height="680"
            loading="lazy"
            decoding="async"
          />
          <figcaption>
            <strong>Delivery detail</strong>
            <span>Quotation should include pumps, pipework, spares, packing and site limits, not only the main machine.</span>
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  {
    featuredVideo && (
      <section class="section workshop-video">
        <div class="container workshop-video__layout">
          <a
            class="workshop-video__poster"
            href={`/videos/${featuredVideo.id}/`}
            aria-label={`Watch ${featuredVideo.data.title}`}
          >
            <img
              src={featuredVideo.data.posterImage?.src ?? homepageData.hero.poster}
              alt={featuredVideo.data.posterImage?.alt ?? 'Mineral processing equipment factory video'}
              width="1915"
              height="821"
              loading="lazy"
              decoding="async"
            />
            <span aria-hidden="true">Play factory video</span>
          </a>
          <div class="workshop-video__copy">
            <span>Real workshop footage</span>
            <h2>See fabrication and assembly before discussing a machine list.</h2>
            <p>
              The video shows equipment at different production stages. It is manufacturing
              evidence, not a recovery or capacity guarantee for another ore.
            </p>
            <a class="text-link" href={`/videos/${featuredVideo.id}/`}>Watch with technical context</a>
          </div>
        </div>
      </section>
    )
  }

  <section class="testing section">
    <div class="container testing-grid">
      <div class="testing-notes">
        <span>Before a model number</span>
        <ul>
          <li><strong>Alluvial gold:</strong> Is the clay washed clean before fine gold recovery?</li>
          <li><strong>Rock gold:</strong> Is the gold liberated, or is grinding still the real question?</li>
          <li><strong>Tin / tungsten:</strong> Is it placer ore or rock ore? The front-end can change completely.</li>
        </ul>
      </div>
      <div>
        <h2>Small test work is cheaper than a wrong plant.</h2>
        <p>
          If the ore facts are unclear, the first answer should be a test route, not a full
          equipment list. Gravity test work, size checks and simple loss observations usually show
          which section needs attention first.
        </p>
        <a class="text-link" href="/testing-process-design/">How testing informs the flowsheet</a>
      </div>
    </div>
  </section>

  <section class="section projects">
    <div class="container">
      <div class="section-heading">
        <div>
          <h2>Case notes you can compare with your ore.</h2>
        </div>
        <p>
          These case notes show how a project is read: ore condition first, then process route,
          then equipment duty. Use the closest case as a starting point for your own enquiry.
        </p>
      </div>
      <div class="project-ledger">
        {projects.map((project) => (
          <article>
            <div class="project-ledger__meta">
              <span>{project.data.country}</span>
              <strong>{project.data.capacity}</strong>
            </div>
            <h3>
              <a class="project-title-link" href={`/projects/${project.id}/`}>
                {project.data.title}
              </a>
            </h3>
            <div class="project-ledger__summary">
              <p>{project.data.description}</p>
              <small>Send similar ore photos and I will check what data is still missing.</small>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section knowledge-preview">
    <div class="container">
      <div class="section-heading">
        <div>
          <h2>Useful answers before a sales call.</h2>
        </div>
        <a class="text-link" href="/knowledge/">View all knowledge</a>
      </div>
      <div class="article-list">
        {articles.map((article, index) => (
          <a href={`/knowledge/${article.id}/`}>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <div>
              <small>{article.data.category}</small>
              <h3>{article.data.title}</h3>
            </div>
            <b>→</b>
          </a>
        ))}
      </div>
    </div>
  </section>

</BaseLayout>

<script>
  const heroVideo = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  const heroVideoToggle = document.querySelector<HTMLButtonElement>('[data-hero-video-toggle]');

  if (heroVideo && heroVideoToggle) {
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const updateVideoButton = () => {
      const isPlaying = !heroVideo.paused;
      heroVideoToggle.textContent = isPlaying ? 'Pause video' : 'Play video';
      heroVideoToggle.setAttribute('aria-pressed', String(isPlaying));
    };

    if (!reducedMotion) {
      heroVideo.play().catch(() => updateVideoButton());
    }

    updateVideoButton();
    heroVideo.addEventListener('play', updateVideoButton);
    heroVideo.addEventListener('pause', updateVideoButton);
    heroVideoToggle.addEventListener('click', () => {
      if (heroVideo.paused) heroVideo.play().catch(() => updateVideoButton());
      else heroVideo.pause();
    });
  }
</script>

<style>
  /* Hallmark · macrostructure: Process Desk · tone: industrial editorial · anchor hue: mineral gold */
  .hero {
    position: relative;
    min-height: 790px;
    overflow: hidden;
    color: var(--white);
    background: #151615;
  }

  .hero-media {
    position: absolute;
    inset: 0;
  }

  .hero-media::after {
    position: absolute;
    inset: 0;
    content: '';
    background:
      linear-gradient(90deg, rgba(18, 18, 17, 0.98) 0%, rgba(18, 18, 17, 0.82) 42%, rgba(18, 18, 17, 0.2) 76%, rgba(18, 18, 17, 0.42) 100%),
      linear-gradient(0deg, rgba(18, 18, 17, 0.82), transparent 44%);
  }

  .hero-media img,
  .hero-media video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero-media-tools {
    position: absolute;
    z-index: 2;
    right: max(20px, calc((100vw - var(--max)) / 2));
    bottom: 26px;
    display: flex;
    max-width: 360px;
    align-items: flex-end;
    gap: 12px;
  }

  .hero-media-tools p {
    margin: 0;
    padding: 12px 14px;
    border-left: 2px solid var(--gold);
    color: rgba(255, 253, 248, 0.68);
    background: rgba(18, 18, 17, 0.72);
    font-size: 0.7rem;
    line-height: 1.45;
    backdrop-filter: blur(8px);
  }

  .hero-media-tools strong,
  .hero-media-tools span {
    display: block;
  }

  .hero-media-tools strong {
    margin-bottom: 3px;
    color: var(--gold-light);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .hero-video-toggle {
    min-width: 48px;
    min-height: 48px;
    padding: 8px 12px;
    border: 1px solid rgba(255, 255, 255, 0.42);
    color: var(--white);
    background: rgba(18, 18, 17, 0.76);
    cursor: pointer;
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hero-video-toggle:hover {
    color: var(--ink);
    background: var(--gold-light);
  }

  .hero-content {
    position: relative;
    z-index: 1;
    padding-top: 210px;
  }

  .hero h1 {
    max-width: 850px;
    font-size: clamp(4rem, 9vw, 8.2rem);
  }

  .hero p {
    max-width: 620px;
    margin: 28px 0;
    color: rgba(255, 253, 248, 0.72);
    font-size: 1.08rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .hero-human {
    display: grid;
    max-width: 640px;
    gap: 8px;
    margin-top: 22px;
    padding: 18px 20px;
    border: 1px solid rgba(239, 197, 109, 0.26);
    background: rgba(25, 26, 25, 0.58);
    backdrop-filter: blur(8px);
  }

  .hero-human strong {
    color: var(--gold-light);
    font-family: var(--font-display);
    font-size: 1.45rem;
    line-height: 1;
    text-transform: uppercase;
  }

  .hero-human span {
    color: rgba(255, 253, 248, 0.72);
    font-size: 0.9rem;
  }

  .hero-human em {
    color: var(--white);
    font-size: 0.86rem;
    font-style: normal;
    font-weight: 700;
  }

  .hero-human a {
    width: fit-content;
    color: var(--white);
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hero-human a:hover {
    color: var(--gold-light);
  }

  .hero-proof {
    display: flex;
    max-width: 760px;
    margin: 74px 0 0;
    padding: 22px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.18);
    border-bottom: 1px solid rgba(255, 255, 255, 0.18);
    list-style: none;
  }

  .hero-proof li {
    flex: 1;
    padding-right: 22px;
  }

  .hero-proof strong,
  .hero-proof span {
    display: block;
  }

  .hero-proof strong {
    color: var(--gold-light);
    font-family: var(--font-display);
    font-size: 1.5rem;
    text-transform: uppercase;
  }

  .hero-proof span {
    color: rgba(255, 253, 248, 0.55);
    font-size: 0.72rem;
  }

  .principle {
    color: var(--white);
    background: var(--copper);
  }

  .principle-grid {
    display: grid;
    grid-template-columns: minmax(280px, 0.82fr) minmax(0, 1.18fr);
    align-items: start;
    gap: clamp(48px, 8vw, 110px);
    padding-top: 45px;
    padding-bottom: 45px;
  }

  .principle h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3.5rem);
    line-height: 1;
    text-transform: uppercase;
  }

  .principle-checks {
    display: grid;
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .principle-checks li {
    padding: 0 0 14px;
    border-bottom: 1px solid rgba(255, 253, 248, 0.22);
  }

  .principle-checks strong,
  .principle-checks small {
    display: block;
  }

  .principle-checks strong {
    color: var(--white);
    font-family: var(--font-display);
    font-size: 1.45rem;
    line-height: 1;
    text-transform: uppercase;
  }

  .principle-checks small {
    margin: 6px 0 0;
    color: rgba(255, 253, 248, 0.94);
    font-size: 0.88rem;
  }

  .response-path {
    padding: 118px 0 78px;
    background: var(--paper);
  }

  .response-desk {
    display: grid;
    grid-template-columns: minmax(280px, 0.82fr) minmax(0, 1.18fr);
    align-items: stretch;
    gap: clamp(32px, 7vw, 90px);
  }

  .response-desk__lead {
    padding: clamp(28px, 5vw, 50px);
    border-top: 3px solid var(--gold);
    color: var(--white);
    background: var(--charcoal);
  }

  .response-desk__lead > span {
    color: var(--gold-light);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .response-desk__lead h3 {
    margin: 38px 0 18px;
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5vw, 4.6rem);
    line-height: 0.94;
    text-transform: uppercase;
  }

  .response-desk__lead p {
    margin: 0 0 26px;
    color: rgba(255, 253, 248, 0.68);
    font-size: 0.9rem;
  }

  .response-desk__lead .text-link {
    color: var(--gold-light);
  }

  .response-sequence {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
    list-style: none;
  }

  .response-sequence li {
    display: grid;
    grid-template-columns: 62px 1fr;
    gap: 24px;
    padding: 25px 0;
    border-bottom: 1px solid var(--line);
  }

  .response-sequence > li > span {
    color: var(--copper);
    font-family: var(--font-display);
    font-size: 1.5rem;
  }

  .response-sequence h3 {
    margin: 0 0 8px;
    font-family: var(--font-display);
    font-size: clamp(1.65rem, 3vw, 2.35rem);
    line-height: 1;
    text-transform: uppercase;
  }

  .response-sequence p {
    margin: 0;
    color: var(--muted);
    font-size: 0.9rem;
  }

  #solutions {
    padding-top: 104px;
    padding-bottom: 118px;
  }

  .solution-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
  }

  .solution-card {
    position: relative;
    display: grid;
    min-height: 330px;
    grid-template-rows: auto 1fr;
    gap: 48px;
    padding: 28px;
    border: 1px solid var(--line);
    background: rgba(255, 253, 248, 0.72);
    transition:
      color 180ms ease,
      background 180ms ease,
      transform 180ms ease;
  }

  .solution-card--primary {
    min-height: 390px;
    grid-column: span 2;
    grid-template-columns: minmax(0, 0.9fr) minmax(230px, 1.1fr);
    grid-template-rows: auto 1fr;
    gap: 0;
    padding: 0;
    color: var(--white);
    background:
      linear-gradient(140deg, rgba(211, 154, 56, 0.13), transparent 40%),
      var(--charcoal);
  }

  .solution-card:hover {
    color: var(--white);
    background: var(--copper);
    transform: translateY(-4px);
  }

  .solution-card--primary:hover {
    background: var(--charcoal-soft);
  }

  .solution-card__number {
    color: var(--gold);
    font-family: var(--font-display);
