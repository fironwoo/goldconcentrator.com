---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ProjectCta from '../../components/ProjectCta.astro';
import { getYouTubeEmbedUrl } from '../../lib/site';

const videos = (await getCollection('videos'))
  .filter((entry) => !entry.data.draft && (entry.data.videoFile || getYouTubeEmbedUrl(entry.data.youtubeUrl)))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
---

<BaseLayout
  title="Mineral Processing Field & Equipment Videos"
  description="Approved workshop, test-work, equipment-operation and delivery videos with practical mineral processing context."
>
  <header class="page-hero">
    <div class="container">
      <Breadcrumbs items={[{ label: 'Videos' }]} />
      <span class="eyebrow">Visible process evidence</span>
      <h1>Videos</h1>
      <p>
        Short workshop, testing and site clips are published with enough context to explain what
        the equipment is doing and what the footage cannot prove.
      </p>
    </div>
  </header>

  <section class="section">
    <div class="container video-grid">
      {
        videos.map((video) => (
          <article class:list={['surface-card', { 'surface-card--media': video.data.posterImage }] }>
            {
              video.data.posterImage && (
                <img
                  class="video-cover"
                  src={video.data.posterImage.src}
                  alt={video.data.posterImage.alt}
                  width="980"
                  height="552"
                  loading="lazy"
                  decoding="async"
                />
              )
            }
            <div class="video-meta">
              <span class="tag">{video.data.mineral}</span>
              <time datetime={video.data.publishedAt.toISOString()}>
                {video.data.publishedAt.toLocaleDateString('en', { dateStyle: 'medium' })}
              </time>
            </div>
            <h2><a href={`/videos/${video.id}/`}>{video.data.title}</a></h2>
            <p>{video.data.description}</p>
            <a class="text-link" href={`/videos/${video.id}/`}>Watch with context</a>
          </article>
        ))
      }
    </div>
  </section>
  <ProjectCta />
</BaseLayout>

<style>
  .video-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }

  .surface-card--media {
    padding-top: 0;
  }

  .video-cover {
    width: calc(100% + 56px);
    aspect-ratio: 16 / 9;
    margin: 0 -28px 24px;
    object-fit: cover;
    background: var(--charcoal);
  }

  .video-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  time {
    color: var(--muted);
    font-size: 0.72rem;
  }

  h2 {
    margin: 28px 0 14px;
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3.2rem);
    line-height: 0.98;
    text-transform: uppercase;
  }

  h2 a:hover {
    color: var(--copper);
  }

  @media (max-width: 700px) {
    .video-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
